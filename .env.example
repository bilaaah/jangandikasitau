# =============================================================================
# BizCapacity — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# .env.local is NEVER committed to Git.
# This file (.env.example) SHOULD be committed — it contains placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (required from Milestone 1)
# PostgreSQL connection string — use Neon or Supabase
# Neon example:    postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/bizcapacity?sslmode=require
# Supabase example: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/bizcapacity?sslmode=require"

# -----------------------------------------------------------------------------
# DEVELOPMENT SEED (required from Milestone 1, local dev only)
# The UUID of the seeded Business record used during development without auth.
# Run `npm run db:seed` to create it, then paste the generated UUID here.
# Remove this variable before production deployment.
# -----------------------------------------------------------------------------
DEV_BUSINESS_ID="replace-after-running-npm-run-db-seed"

# -----------------------------------------------------------------------------
# NEXTAUTH (required from Milestone 2)
# Generate NEXTAUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="generate-a-random-secret-do-not-use-this-value"

# -----------------------------------------------------------------------------
# AI PROVIDER (required from Milestone 3 — choose one)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
